# ChatGit workspace. app/ (LibreChat) keeps its own app/.gitignore.

# dependencies (root, app/ and legacy/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# local runtime state: generated secrets, MongoDB data, logs, overrides
/.chatgit/

# app runtime/build artifacts not covered by app/.gitignore
/app/uploads/
/app/logs/
/app/api/logs/
/app/client/vite-output.log

# protected task supervisor
/.next-safe.lock
/scripts/__pycache__/

# Amp orb generated portal state
.amp/portals/
.amp/in/

# legacy Next.js reference app
/legacy/chatgit/.next*/
/legacy/chatgit/out/
/legacy/chatgit/build/
next-env.d.ts

# testing
/coverage

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
