{
  "name": "chatgit",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGit workspace: protected entrypoints for the LibreChat-based app in app/",
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "check:safety": "python3 scripts/next_safe.py --check",
    "setup:app": "python3 scripts/next_safe.py install",
    "build": "python3 scripts/next_safe.py build",
    "dev": "python3 scripts/next_safe.py dev",
    "open": "python3 scripts/chatgit_open.py",
    "test:safety": "python3 -m unittest discover -s scripts -p 'test_*.py' -v"
  }
}
